; Kraken IR

fn @main() -> i64 {
entry:
    %0 = alloca i64 ; a
    store 10, %0
    %1 = alloca i64 ; b
    store 20, %1
    %2 = alloca i64 ; sum
    %3 = load i64 from %0
    %4 = load i64 from %1
    %5 = Plus i64 %3, %4
    store %5, %2
    %6 = alloca i64 ; diff
    %7 = load i64 from %1
    %8 = load i64 from %0
    %9 = Minus i64 %7, %8
    store %9, %6
    %10 = load i64 from %2
    %11 = load i64 from %6
    %12 = Plus i64 %10, %11
    ret %12
}
