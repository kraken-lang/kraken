// Stress test: Deep recursion
// Tests compiler's ability to handle deep recursive function calls

fn fibonacci(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn factorial(n: int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn deep_recursion(depth: int) -> int {
    if (depth <= 0) {
        return 0;
    }
    return 1 + deep_recursion(depth - 1);
}

fn main() -> int {
    // Test moderate recursion depth
    let fib_result = fibonacci(20);
    let fact_result = factorial(10);
    let deep_result = deep_recursion(100);
    
    puts("Deep recursion stress test passed");
    return 0;
}
