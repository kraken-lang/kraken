// Test: vec_int_reserve and vec_int_shrink_to_fit

fn main() {
    let v = vec_int_new();
    
    // Initial capacity is 4
    assert_eq(vec_int_capacity(v), 4);
    
    // Reserve more capacity
    vec_int_reserve(v, 100);
    assert_eq(vec_int_capacity(v), 100);
    assert_eq(vec_int_len(v), 0);
    
    // Push some elements
    vec_int_push(v, 1);
    vec_int_push(v, 2);
    vec_int_push(v, 3);
    assert_eq(vec_int_len(v), 3);
    assert_eq(vec_int_capacity(v), 100);
    
    // Shrink to fit
    vec_int_shrink_to_fit(v);
    assert_eq(vec_int_capacity(v), 3);
    assert_eq(vec_int_len(v), 3);
    
    // Data should still be intact
    assert_eq(vec_int_get(v, 0), 1);
    assert_eq(vec_int_get(v, 1), 2);
    assert_eq(vec_int_get(v, 2), 3);
    
    // Reserve less than current cap should be no-op
    vec_int_reserve(v, 2);
    assert_eq(vec_int_capacity(v), 3);
    
    vec_int_free(v);
    puts("vec_int_reserve/shrink_to_fit tests passed!");
}
