// Test advanced struct padding and alignment calculations

extern fn kraken_calculate_padding(offset: int, alignment: int) -> int;
extern fn kraken_align_offset(offset: int, alignment: int) -> int;
extern fn kraken_type_alignment(type_size: int) -> int;

fn test_padding_calculation() -> int {
    // Test padding calculation
    let padding1: int = kraken_calculate_padding(5, 4);  // Should be 3
    let padding2: int = kraken_calculate_padding(8, 4);  // Should be 0
    let padding3: int = kraken_calculate_padding(1, 8);  // Should be 7
    
    return padding1 + padding2 + padding3;
}

fn test_offset_alignment() -> int {
    // Test offset alignment
    let aligned1: int = kraken_align_offset(5, 4);   // Should be 8
    let aligned2: int = kraken_align_offset(8, 4);   // Should be 8
    let aligned3: int = kraken_align_offset(1, 16);  // Should be 16
    
    return aligned1 + aligned2 + aligned3;
}

fn test_type_alignment() -> int {
    // Test type alignment calculation
    let align1: int = kraken_type_alignment(1);  // Should be 1
    let align2: int = kraken_type_alignment(2);  // Should be 2
    let align4: int = kraken_type_alignment(4);  // Should be 4
    let align8: int = kraken_type_alignment(8);  // Should be 8
    
    return align1 + align2 + align4 + align8;
}

fn main() -> int {
    let result1: int = test_padding_calculation();
    let result2: int = test_offset_alignment();
    let result3: int = test_type_alignment();
    
    return result1 + result2 + result3;
}
