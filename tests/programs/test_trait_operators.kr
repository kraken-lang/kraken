// Test operator overloading traits

// Define Add trait
trait Add {
    fn add(self, other: Self) -> Self;
}

// Point struct
struct Point {
    x: int,
    y: int,
}

// Implement Add for Point
impl Add for Point {
    fn add(self, other: Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}

// Define Display trait
trait Display {
    fn fmt(self) -> str;
}

impl Display for Point {
    fn fmt(self) -> str {
        return "Point";
    }
}

fn main() -> int {
    let p1: Point = Point { x: 10, y: 20 };
    let p2: Point = Point { x: 5, y: 15 };
    let p3: Point = p1.add(p2);
    
    return 0;
}
