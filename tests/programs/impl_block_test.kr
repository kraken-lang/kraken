// Impl Block Test
// Tests impl block declarations and method definitions

// Basic impl block
struct Point {
    x: int;
    y: int;
}

impl Point {
    fn new(x: int, y: int) -> Point {
        return Point { x: x, y: y };
    }
    
    fn origin() -> Point {
        return Point { x: 0, y: 0 };
    }
}

fn test_associated_functions() {
    let p1 = Point::new(10, 20);
    let p2 = Point::origin();
}

