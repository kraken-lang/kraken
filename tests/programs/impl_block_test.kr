// Multiple impl blocks for same type
struct Counter {
    value: int;
}

impl Counter {
    fn new() -> Counter {
        return Counter { value: 0 };
    }
}

impl Counter {
    fn with_value(v: int) -> Counter {
        return Counter { value: v };
    }
}

fn test_multiple_impl_blocks() {
    let c1 = Counter::new();
    let c2 = Counter::with_value(42);
}

// Impl block with public and private methods
struct Rectangle {
    width: int;
    height: int;
}

impl Rectangle {
    pub fn new(w: int, h: int) -> Rectangle {
        return Rectangle { width: w, height: h };
    }
    
    fn area(w: int, h: int) -> int {
        return w * h;
    }
}

fn test_visibility() {
    let r = Rectangle::new(10, 20);
}

