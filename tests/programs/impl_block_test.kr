// Impl block for enum
enum Option {
    Some(int),
    None,
}

impl Option {
    fn some(value: int) -> Option {
        return Option::Some(value);
    }
    
    fn none() -> Option {
        return Option::None;
    }
}

fn test_enum_impl() {
    let opt1 = Option::some(42);
    let opt2 = Option::none();
}

// Impl block with multiple parameters
struct Calculator {
    result: int;
}

impl Calculator {
    fn new() -> Calculator {
        return Calculator { result: 0 };
    }
    
    fn add(a: int, b: int) -> int {
        return a + b;
    }
    
    fn multiply(a: int, b: int, c: int) -> int {
        return a * b * c;
    }
}

fn test_multiple_params() {
    let calc = Calculator::new();
    let sum = Calculator::add(10, 32); // 42
    let product = Calculator::multiply(2, 3, 7); // 42
}

// Impl block with complex return types
struct Pair {
    first: int;
    second: int;
}

impl Pair {
    fn create(a: int, b: int) -> Pair {
        return Pair { first: a, second: b };
    }
    
    fn swap(p: Pair) -> Pair {
        return Pair { first: p.second, second: p.first };
    }
}

fn test_complex_returns() {
    let p1 = Pair::create(10, 20);
    let p2 = Pair::swap(p1);
}

// Impl block with nested calls
struct Math {
    dummy: int;
}

impl Math {
    fn double(x: int) -> int {
        return x * 2;
    }
    
    fn quadruple(x: int) -> int {
        return Math::double(Math::double(x));
    }
}

fn test_nested_calls() {
    let result = Math::quadruple(10); // 40
}

