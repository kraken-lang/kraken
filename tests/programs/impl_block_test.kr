// Impl block with conditional logic
struct Validator {
    dummy: int;
}

impl Validator {
    fn is_positive(x: int) -> bool {
        if (x > 0) {
            return true;
        } else {
            return false;
        }
    }
    
    fn max(a: int, b: int) -> int {
        if (a > b) {
            return a;
        } else {
            return b;
        }
    }
}

fn test_conditional_methods() {
    let is_pos = Validator::is_positive(42); // true
    let maximum = Validator::max(10, 20); // 20
}

// Impl block with loops
struct ArrayHelper {
    dummy: int;
}

impl ArrayHelper {
    fn sum_range(start: int, end: int) -> int {
        let total = 0;
        let i = start;
        while (i < end) {
            total = total + i;
            i = i + 1;
        }
        return total;
    }
}

fn test_loop_methods() {
    let sum = ArrayHelper::sum_range(1, 11); // 55
}

fn main() {
    test_associated_functions();
    test_multiple_impl_blocks();
    test_visibility();
    test_enum_impl();
    test_multiple_params();
    test_complex_returns();
    test_nested_calls();
    test_conditional_methods();
    test_loop_methods();
}
