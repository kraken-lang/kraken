fn main() -> int {
    let f: bytes = fopen("kraken_ffi_tmp_roundtrip.bin", "wb+");
    let data: bytes = "abcd";
    let w = fwrite(data, 1, 4, f);
    if (w != 4) {
        return 10;
    }

    rewind(f);

    let buf: bytes = malloc(4);
    let r = fread(buf, 1, 4, f);
    if (r != 4) {
        return 11;
    }

    if (memcmp(buf, data, 4) != 0) {
        return 12;
    }

    return 0;
}
