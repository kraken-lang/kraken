struct Lexer {
    source: string;
    pos: int;
    length: int;
    line: int;
    column: int;
}

fn new_lexer(src: string) -> Lexer {
    return Lexer { source: src, pos: 0, length: strlen(src), line: 1, column: 1 };
}

fn lex_at_end(lex: Lexer) -> bool {
    return lex.pos >= lex.length;
}

fn lex_advance(lex: Lexer) -> Lexer {
    return Lexer { source: lex.source, pos: lex.pos + 1, length: lex.length, line: lex.line, column: lex.column + 1 };
}

fn lex_peek(lex: Lexer) -> int {
    return str_char_at(lex.source, lex.pos);
}

fn tokenize(source: string, kinds: VecInt, lexemes: VecString, lines: VecInt, cols: VecInt) -> int {
    let lex: Lexer = new_lexer(source);
    let count = 0;

    while (!lex_at_end(lex)) {
        let c = lex_peek(lex);
        vec_int_push(kinds, c);
        vec_string_push(lexemes, "x");
        vec_int_push(lines, lex.line);
        vec_int_push(cols, lex.column);
        lex = lex_advance(lex);
        count = count + 1;
    }
    return count;
}

fn main() -> int {
    let kinds: VecInt = vec_int_new();
    let lexemes: VecString = vec_string_new();
    let lines: VecInt = vec_int_new();
    let cols: VecInt = vec_int_new();

    let count = tokenize("hello", kinds, lexemes, lines, cols);
    puts(str_concat("count: ", fmt_int(count)));

    let i = 0;
    while (i < count) {
        puts(fmt_int(vec_int_get(kinds, i)));
        i = i + 1;
    }

    vec_int_free(kinds);
    vec_string_free(lexemes);
    vec_int_free(lines);
    vec_int_free(cols);
    return 0;
}
