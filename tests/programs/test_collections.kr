// Collection Helper Functions Tests for 0.8.25
// Tests array operations, range iterators, and utility functions

// External declarations for collection functions
extern fn kraken_range_iter(start: int, end: int, step: int) -> int;
extern fn kraken_range_next(iter: int, value_ptr: int) -> int;
extern fn kraken_range_free(iter: int) -> void;
extern fn kraken_clone(value: int, size: int) -> int;
extern fn kraken_array_any(arr: int, len: int, elem_size: int, predicate: int) -> int;
extern fn kraken_array_all(arr: int, len: int, elem_size: int, predicate: int) -> int;
extern fn kraken_array_find(arr: int, len: int, elem_size: int, predicate: int) -> int;

// Test range iterator
fn test_range_iterator() -> int {
    puts("Testing range iterator...");
    
    let iter = kraken_range_iter(0, 5, 1);
    
    if (iter != 0) {
        puts("Range iterator created");
        kraken_range_free(iter);
        puts("Range iterator freed");
    }
    
    return 0;
}

