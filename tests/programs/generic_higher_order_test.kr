// ============================================================================
// Main Test Runner
// ============================================================================

fn main() {
    // Basic tests
    test_map_basic();
    test_map_transform();
    test_filter_basic();
    test_filter_strings();
    test_fold_sum();
    test_fold_product();
    test_fold_string_concat();
    
    // Chaining tests
    test_chain_map_filter();
    test_chain_filter_map_fold();
    
    // Multi-type parameter tests
    test_zip_basic();
    
    // Closure capture tests
    test_closure_capture_generic();
    test_closure_capture_multiple();
    
    // Higher-order closure tests
    test_make_adder();
    test_make_adder_with_map();
    
    // Advanced tests
    test_flat_map();
    test_partition();
    test_move_closure_generic();
    
    // Type inference tests
    test_inference_from_return();
    test_inference_from_argument();
    test_inference_nested();
    
    println("All generic higher-order function tests completed!");
}
