struct Pos {
    idx: int;
    len: int;
}

fn new_pos(n: int) -> Pos {
    return Pos { idx: 0, len: n };
}

fn pos_done(p: Pos) -> bool {
    return p.idx >= p.len;
}

fn pos_next(p: Pos) -> Pos {
    return Pos { idx: p.idx + 1, len: p.len };
}

fn scan4(source: string, kinds: VecInt, lexemes: VecString, lines: VecInt) -> int {
    let p: Pos = new_pos(strlen(source));
    let count = 0;
    while (!pos_done(p)) {
        let c = str_char_at(source, p.idx);
        vec_int_push(kinds, c);
        vec_string_push(lexemes, "x");
        vec_int_push(lines, p.idx);
        p = pos_next(p);
        count = count + 1;
    }
    return count;
}

fn main() -> int {
    let kinds: VecInt = vec_int_new();
    let lexemes: VecString = vec_string_new();
    let lines: VecInt = vec_int_new();

    let count = scan4("hello", kinds, lexemes, lines);
    puts(str_concat("count: ", fmt_int(count)));

    vec_int_free(kinds);
    vec_string_free(lexemes);
    vec_int_free(lines);
    return 0;
}
