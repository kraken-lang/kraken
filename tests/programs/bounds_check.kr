// Test: Bounds checking (when KRAKEN_DEBUG_BOUNDS=1)
// Expected: Compiles and runs, returns 0 for valid access

fn main() -> int {
    let v: VecInt = vec_int_new();
    vec_int_push(v, 10);
    vec_int_push(v, 20);
    vec_int_push(v, 30);
    
    // Valid accesses
    let a: int = vec_int_get(v, 0);
    let b: int = vec_int_get(v, 1);
    let c: int = vec_int_get(v, 2);
    
    vec_int_free(v);
    
    // Should be 10 + 20 + 30 = 60
    return (a + b + c) - 60;
}
