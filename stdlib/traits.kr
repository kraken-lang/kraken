// Kraken Standard Library - Core Traits
// Version: 0.8.27

// ============================================================================
// ITERATOR TRAITS
// ============================================================================

/// Iterator trait for sequential element access
pub trait Iterator {
    type Item;
    
    fn next(self) -> Option<Self::Item>;
}

/// IntoIterator trait for types that can be converted into iterators
pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;
    
    fn into_iter(self) -> Self::IntoIter;
}

// ============================================================================
// OPERATOR OVERLOADING TRAITS - ARITHMETIC
// ============================================================================

/// Addition operator trait
pub trait Add<Rhs = Self> {
    type Output;
    fn add(self, rhs: Rhs) -> Self::Output;
}

/// Subtraction operator trait
pub trait Sub<Rhs = Self> {
    type Output;
    fn sub(self, rhs: Rhs) -> Self::Output;
}

/// Multiplication operator trait
pub trait Mul<Rhs = Self> {
    type Output;
    fn mul(self, rhs: Rhs) -> Self::Output;
}

/// Division operator trait
pub trait Div<Rhs = Self> {
    type Output;
    fn div(self, rhs: Rhs) -> Self::Output;
}

/// Remainder operator trait
pub trait Rem<Rhs = Self> {
    type Output;
    fn rem(self, rhs: Rhs) -> Self::Output;
}

/// Negation operator trait
pub trait Neg {
    type Output;
    fn neg(self) -> Self::Output;
}

// ============================================================================
// OPERATOR OVERLOADING TRAITS - BITWISE
// ============================================================================

/// Bitwise AND operator trait
pub trait BitAnd<Rhs = Self> {
    type Output;
    fn bitand(self, rhs: Rhs) -> Self::Output;
}

/// Bitwise OR operator trait
pub trait BitOr<Rhs = Self> {
    type Output;
    fn bitor(self, rhs: Rhs) -> Self::Output;
}

/// Bitwise XOR operator trait
pub trait BitXor<Rhs = Self> {
    type Output;
    fn bitxor(self, rhs: Rhs) -> Self::Output;
}

/// Bitwise NOT operator trait
pub trait Not {
    type Output;
    fn not(self) -> Self::Output;
}

/// Left shift operator trait
pub trait Shl<Rhs = Self> {
    type Output;
    fn shl(self, rhs: Rhs) -> Self::Output;
}

/// Right shift operator trait
pub trait Shr<Rhs = Self> {
    type Output;
    fn shr(self, rhs: Rhs) -> Self::Output;
}

// ============================================================================
// COMPARISON TRAITS
// ============================================================================

/// Partial equality comparison trait
pub trait PartialEq<Rhs = Self> {
    fn eq(self, other: Rhs) -> bool;
    
    fn ne(self, other: Rhs) -> bool {
        return !self.eq(other);
    }
}

/// Full equality comparison trait
pub trait Eq: PartialEq<Self> {}

/// Partial ordering comparison trait
pub trait PartialOrd<Rhs = Self>: PartialEq<Rhs> {
    fn partial_cmp(self, other: Rhs) -> Option<Ordering>;
    
    fn lt(self, other: Rhs) -> bool {
        return false;
    }
    
    fn le(self, other: Rhs) -> bool {
        return false;
    }
    
    fn gt(self, other: Rhs) -> bool {
        return false;
    }
    
    fn ge(self, other: Rhs) -> bool {
        return false;
    }
}

/// Total ordering comparison trait
pub trait Ord: Eq + PartialOrd<Self> {
    fn cmp(self, other: Self) -> Ordering;
}

// ============================================================================
// INDEXING TRAITS
// ============================================================================

/// Indexing operator trait (immutable)
pub trait Index<Idx> {
    type Output;
    fn index(self, index: Idx) -> Self::Output;
}

/// Indexing operator trait (mutable)
pub trait IndexMut<Idx>: Index<Idx> {
    fn index_mut(self, index: Idx) -> Self::Output;
}

// ============================================================================
// CONVERSION TRAITS
// ============================================================================

/// Infallible conversion trait
pub trait From<T> {
    fn from(value: T) -> Self;
}

/// Infallible conversion trait (reciprocal of From)
pub trait Into<T> {
    fn into(self) -> T;
}

/// Fallible conversion trait
pub trait TryFrom<T> {
    type Error;
    fn try_from(value: T) -> Result<Self, Self::Error>;
}

/// Fallible conversion trait (reciprocal of TryFrom)
pub trait TryInto<T> {
    type Error;
    fn try_into(self) -> Result<T, Self::Error>;
}

/// Cheap reference-to-reference conversion
pub trait AsRef<T> {
    fn as_ref(self) -> T;
}

/// Cheap mutable reference-to-reference conversion
pub trait AsMut<T> {
    fn as_mut(self) -> T;
}

// ============================================================================
// STANDARD TRAITS
// ============================================================================

/// Display trait for user-facing string formatting
pub trait Display {
    fn fmt(self) -> str;
}

/// Debug trait for debug output
pub trait Debug {
    fn fmt(self) -> str;
}

/// Clone trait for explicit copying
pub trait Clone {
    fn clone(self) -> Self;
}

/// Copy marker trait for implicit copying
pub trait Copy: Clone {}

/// Drop trait for custom cleanup (RAII)
pub trait Drop {
    fn drop(self);
}

/// Default trait for default values
pub trait Default {
    fn default() -> Self;
}

/// Hash trait for hashing
pub trait Hash {
    fn hash(self) -> int;
}

/// Send marker trait for thread safety (can be sent across threads)
pub trait Send {}

/// Sync marker trait for thread safety (can be shared across threads)
pub trait Sync {}

// ============================================================================
// FUNCTION TRAITS
// ============================================================================

/// Immutable function call trait
pub trait Fn<Args> {
    type Output;
    fn call(self, args: Args) -> Self::Output;
}

/// Mutable function call trait
pub trait FnMut<Args>: Fn<Args> {
    fn call_mut(self, args: Args) -> Self::Output;
}

/// Once-callable function trait
pub trait FnOnce<Args> {
    type Output;
    fn call_once(self, args: Args) -> Self::Output;
}

// ============================================================================
// DEREFERENCE TRAITS
// ============================================================================

/// Dereference operator trait (immutable)
pub trait Deref {
    type Target;
    fn deref(self) -> Self::Target;
}

/// Dereference operator trait (mutable)
pub trait DerefMut: Deref {
    fn deref_mut(self) -> Self::Target;
}

// ============================================================================
// HELPER TYPES
// ============================================================================

/// Ordering enum for comparison results
pub enum Ordering {
    Less,
    Equal,
    Greater,
}
