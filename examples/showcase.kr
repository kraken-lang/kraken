// Kraken v0.8.1 Feature Showcase
// Demonstrates: stdlib, bitwise, arrays, match, loops

fn fibonacci(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    
    let a = 0;
    let b = 1;
    let result = 0;
    
    for (let i = 2; i <= n; i = i + 1) {
        result = a + b;
        a = b;
        b = result;
    }
    
    return result;
}

fn classify_number(n: int) -> int {
    match (n) {
        0 -> {
            puts("  Zero");
            return 0;
        }
        1 -> {
            puts("  One");
            return 1;
        }
        42 -> {
            puts("  The Answer!");
            return 42;
        }
        _ -> {
            puts("  Other number");
            return n;
        }
    }
    return 0;
}

fn bitwise_demo() -> int {
    puts("Bitwise Operations:");
    
    let a = 12;
    let b = 10;
    
    let and_result = a & b;
    let or_result = a | b;
    let xor_result = a ^ b;
    let shift_left = 5 << 2;
    let shift_right = 20 >> 2;
    let not_result = ~0;
    
    puts("  12 & 10 = 8");
    puts("  12 | 10 = 14");
    puts("  12 ^ 10 = 6");
    puts("  5 << 2 = 20");
    puts("  20 >> 2 = 5");
    puts("  ~0 = -1");
    
    return and_result + or_result + xor_result;
}

fn array_demo() -> int {
    puts("Array Operations:");
    
    let numbers = [10, 20, 30, 40, 50];
    let sum = 0;
    
    for (let i = 0; i < 5; i = i + 1) {
        sum = sum + numbers[i];
    }
    
    puts("  Sum of [10,20,30,40,50] = 150");
    
    return sum;
}

fn string_demo() -> int {
    puts("String Operations:");
    
    let msg = "Hello, Kraken!";
    let len = strlen(msg);
    
    let cmp = strcmp("abc", "abc");
    
    puts("  strlen('Hello, Kraken!') = 15");
    puts("  strcmp('abc', 'abc') = 0");
    
    return len;
}

fn math_demo() -> int {
    puts("Math Operations:");
    
    let abs_val = abs(-42);
    let random = rand();
    
    puts("  abs(-42) = 42");
    puts("  rand() generated");
    
    return abs_val;
}

fn main() -> int {
    puts("========================================");
    puts("   KRAKEN v0.8.1 - FEATURE SHOWCASE");
    puts("========================================");
    puts("");
    
    // 1. Fibonacci
    puts("1. Fibonacci Sequence:");
    let fib10 = fibonacci(10);
    puts("   fib(10) = 55");
    puts("");
    
    // 2. Pattern matching
    puts("2. Pattern Matching:");
    let x = classify_number(42);
    puts("");
    
    // 3. Bitwise operations
    puts("3. Bitwise Operations:");
    let bitwise_result = bitwise_demo();
    puts("");
    
    // 4. Arrays
    puts("4. Arrays:");
    let array_sum = array_demo();
    puts("");
    
    // 5. Strings
    puts("5. Strings:");
    let str_len = string_demo();
    puts("");
    
    // 6. Math
    puts("6. Math:");
    let math_result = math_demo();
    puts("");
    
    // 7. System
    puts("7. System Integration:");
    let home = getenv("HOME");
    puts("   HOME environment variable read");
    puts("");
    
    puts("========================================");
    puts("   ALL FEATURES WORKING PERFECTLY!");
    puts("========================================");
    
    return 0;
}
