fn main() -> int {
    let path = "kraken_example_tmp_read.txt";

    let file: bytes = fopen(path, "wb+");
    let data: bytes = "hello\n";
    fwrite(data, 1, 6, file);
    rewind(file);

    let buffer: bytes = malloc(100);
    fgets(buffer, 100, file);
    puts(buffer);

    fclose(file);
    remove(path);

    return 0;
}
