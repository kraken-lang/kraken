fn main() -> int {
    puts("=== KRAKEN v0.8.0 ===");
    
    // Bitwise: 8 + 14 + 6 + 20 = 48
    let result = (12 & 10) + (12 | 10) + (12 ^ 10) + (5 << 2);
    
    // Arrays
    let nums = [10, 20, 30];
    let n = nums[1];
    
    // Match
    match (result) {
        48 -> { puts("Bitwise math correct\!"); }
        _ -> { puts("Error"); }
    }
    
    puts("All features working\!");
    return result;
}
