// Example: Test Framework - assert, assert_eq, assert_ne
//
// The test framework provides three assertion functions:
// - assert(cond)      : Aborts if condition is false
// - assert_eq(a, b)   : Aborts if a != b  
// - assert_ne(a, b)   : Aborts if a == b

fn test_basic_math() {
    let sum = 2 + 2;
    assert_eq(sum, 4);
    
    let product = 3 * 7;
    assert_eq(product, 21);
    
    let difference = 10 - 3;
    assert_ne(difference, 0);
}

fn test_comparisons() {
    assert(5 > 3);
    assert(10 >= 10);
    assert(1 < 100);
    assert(0 <= 0);
}

fn test_variables() {
    let x = 42;
    let y = 42;
    let z = 100;
    
    assert_eq(x, y);
    assert_ne(x, z);
    assert(x == y);
    assert(x != z);
}

fn main() {
    puts("Running test suite...");
    
    test_basic_math();
    puts("  [PASS] test_basic_math");
    
    test_comparisons();
    puts("  [PASS] test_comparisons");
    
    test_variables();
    puts("  [PASS] test_variables");
    
    puts("All tests passed!");
}
