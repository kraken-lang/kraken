        puts("Closing file: " + self.path);
        // close_file(self.handle);
    }
}

fn raii_example() -> void {
    {
        let f = File { handle: 1, path: "data.txt" };
        // Use file...
    }  // f.drop() called automatically here
    
    puts("File has been closed");
}

// =============================================================================
// EXAMPLE 11: Generic Trait Implementation
// =============================================================================

struct Box<T> {
    value: T,
}

impl<T: Clone> Clone for Box<T> {
    fn clone(self) -> Box<T> {
        return Box { value: self.value.clone() };
    }
}

impl<T: Debug> Debug for Box<T> {
    fn fmt(self, f: Formatter) -> Result<void, Error> {
        return write(f, "Box({:?})", self.value);
    }
}

// =============================================================================
// EXAMPLE 12: Vec Methods with Closures
// =============================================================================

fn vec_methods_example() -> void {
    let numbers = vec![1, 2, 3, 4, 5];
    
    // Map: transform each element
    let doubled = numbers.map(|x| x * 2);
    // Result: [2, 4, 6, 8, 10]
    
    // Filter: keep elements matching predicate
    let evens = numbers.filter(|x| x % 2 == 0);
    // Result: [2, 4]
    
    // Fold: reduce to single value
    let sum = numbers.fold(0, |acc, x| acc + x);
    // Result: 15
    
    // For each: side effects
    numbers.for_each(|x| println(x));
}

// =============================================================================
// EXAMPLE 13: Option Methods with Closures
// =============================================================================

fn option_methods_example() -> void {
    let some_value = Some(42);
    let none_value: Option<int> = None;
    
    // Map: transform the value if present
    let doubled = some_value.map(|x| x * 2);
    // Result: Some(84)
    
    // And then: chain operations
    let result = some_value.and_then(|x| {
        if (x > 40) {
            return Some(x + 10);
        } else {
            return None;
        }
    });
    // Result: Some(52)
    
    // Filter: keep value if predicate matches
    let filtered = some_value.filter(|x| x > 40);
    // Result: Some(42)
    
    // Or else: provide alternative
    let value = none_value.or_else(|| Some(0));
    // Result: Some(0)
}

// =============================================================================
// EXAMPLE 14: Result Methods with Closures
// =============================================================================

fn result_methods_example() -> void {
    let ok_value: Result<int, str> = Ok(42);
    let err_value: Result<int, str> = Err("error");
    
    // Map: transform the Ok value
    let doubled = ok_value.map(|x| x * 2);
    // Result: Ok(84)
    
    // Map err: transform the Err value
    let mapped_err = err_value.map_err(|e| "Error: " + e);
    // Result: Err("Error: error")
    
    // And then: chain operations
    let result = ok_value.and_then(|x| {
        if (x > 40) {
            return Ok(x + 10);
        } else {
            return Err("too small");
        }
    });
    // Result: Ok(52)
}

